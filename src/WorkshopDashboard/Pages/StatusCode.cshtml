@page "/status/{code:int}"
@model StatusCodeModel
@{
    ViewData["Title"] = Model.IsNotFound ? "Page not found" : "The page couldn't be loaded";
}

<div class="page page-message">
    @if (Model.IsNotFound)
    {
        <h1>Page not found</h1>
        <p>There's no page at this address. Check the address, or go back to the <a href="/">lesson list</a>.</p>
    }
    else
    {
        <h1>The page couldn't be loaded</h1>
        <p>The server returned status code @Model.Code for this request. Refresh the page. If the problem continues, go back to the <a href="/">lesson list</a>.</p>
    }
</div>
