<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Saba Jamalian</Authors>
    <Product>GitHub Actions Workshop</Product>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A new security advisory for a dependency shows up as a warning instead of breaking every copy of this template. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
